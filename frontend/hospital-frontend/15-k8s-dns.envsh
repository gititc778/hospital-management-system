#!/bin/sh
# Sourced by the nginx image entrypoint before the config template is rendered.
# nginx's resolver ignores the search domains in /etc/resolv.conf, so build the
# full service name suffix (e.g. .hpm.svc.cluster.local) from the pod's own namespace.

NGINX_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)
export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"

search=$(awk '/^search/ { print $2; exit }' /etc/resolv.conf)
case "$search" in
    *.svc.cluster.local) export K8S_DNS_SUFFIX=".$search" ;;
    *)                   export K8S_DNS_SUFFIX="" ;;
esac
